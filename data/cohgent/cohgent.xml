<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!--
        Cohgent: Realistic, plus edits made in the debug editor.

          blanket.xml           weight 90   relative *_scale rules - needs the cohgent fork
          compat/<layer>.xml    weight 96   curated, highest-quality template + layer rules for sharing, absolute values only -
                                            works on upstream Light Rewrite; maintained by hand, never written by tooling
          template/<layer>.xml  weight 95   template + layer rules from editor sessions (absolute values); compat/ wins over it
          instance/<layer>.xml  weight 100  per-light <match_position> entries - needs the cohgent fork
          session_*.xml         weight 101+ unconsolidated imports, newest highest

        Upstream ignores elements and attributes it doesn't know, so positions and scales would silently
        apply to every copy of a template (or do nothing) there - keep them out of compat/.
      -->
      <overrides profile_name="Cohgent"
                 weight="0">
        <!-- The only inherits declaration for Cohgent; session files must not repeat it -->
        <inherits>Realistic</inherits>

        <!-- Groups without overrides are dropped at load, taking the inherits with them -->
        <override tag_name="LR_Cohgent_Placeholder"
                  label="cohgent_placeholder">
          <match mode="exact">lr_cohgent_placeholder.w2ent</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>
